+#[test]
+fn recursive_union_template_in_unlisted_headers() {
+    // libc++'s aligned_union uses this recursive template. Even when the
+    // template is not emitted, bindgen still traverses it during IR analysis.
+    let bindings = Builder::default()
+        .header_contents(
+            "recursive_union.hpp",
+            "template <class T, class... Rest> union RUnion { T value; RUnion<Rest...> rest; };\n\
+             template <class T> union RUnion<T> { T value; };\n\
+             struct Wrap { RUnion<int, float> value; };\n\
+             static unsigned v8__SIZE = sizeof(Wrap);",
+        )
+        .clang_args(["-x", "c++", "-std=c++20"])
+        .allowlist_var("v8__SIZE")
+        .generate()
+        .expect("recursive union templates must not panic");
+    assert!(bindings.to_string().contains("v8__SIZE"));
+}
